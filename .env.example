# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (DB_ENGINE=sqlite só para testes locais)
POSTGRES_DB=carteira
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Salesforce (somente leitura) - podem ficar no env.env da automação, que também é lido
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_INSTANCE_URL=

# Filtros (padrão = os mesmos do Excel.py)
SF_FILTRO_DISTRIBUIDOR=%BRIDA%
SF_SITUACOES_CLIENTE=Ativo,Inativo,Bloqueado
COMPRAS_DESDE_PADRAO=2026-04-01

# Campos opcionais ADICIONAIS de Account (telefone, e-mail, fantasia e última compra já são lidos).
SF_ACCOUNT_CAMPOS_EXTRAS=

# Prospecção: dispara worker em segundo plano ao clicar "Executar agora" (1) ou exige worker permanente (0)
PROSPECCAO_DISPARAR_WORKER=1
# IA (planejamento + interpretação + extração de contatos): OpenAI Responses API.
# Sem chave: "OpenAI aguardando configuração" (as regras seguem, nunca apresentadas como IA).
PROSPECCAO_IA_PROVEDOR=openai
OPENAI_API_KEY=
# Modelo conferido em developers.openai.com/api/docs/models (05/11/2026): US$ 0,10 / 0,50 por MTok (entrada/saída)
PROSPECCAO_IA_MODELO=gpt-6-luna
PROSPECCAO_IA_ESFORCO=low
# PROSPECCAO_IA_MAX_TOKENS=6000          # o limite por pesquisa (Admin) prevalece
# Preço por MTok só se usar modelo fora da tabela interna (desconhecido = estimativa pelo mais caro):
# PROSPECCAO_IA_PRECO_ENTRADA_MTOK=
# PROSPECCAO_IA_PRECO_SAIDA_MTOK=

# Pesquisa web: google (via SerpApi) | openai (web_search da OpenAI – NÃO é Google) | brave | nenhuma
PROSPECCAO_BUSCA_PROVEDOR=google
# Google via SerpApi (terceiro; a API oficial de busca web do Google está fechada a novos clientes)
# Chave: https://serpapi.com/manage-api-key  · plano gratuito 250 buscas/mês
SERPAPI_API_KEY=
# SERPAPI_PRECO_POR_BUSCA_USD=0.025   # use 0 no plano gratuito (o limite passa a ser o número de consultas)
# PROSPECCAO_BUSCA_FALLBACK=openai    # fallback EXPLÍCITO (mostrado como "NÃO é Google"); vazio = sem fallback
# Google sem crédito: a busca segue sozinha pela OpenAI (dentro do teto financeiro)
# PROSPECCAO_IDENTIFICACAO_FALLBACK=openai     # "nenhuma" desliga a troca automática
# PROSPECCAO_DESCOBERTA_RESERVA_MAX=6          # consultas de empresas novas pela OpenAI por execução (0 = só identificação)
# OPENAI_PRECO_WEB_SEARCH_CHAMADA_USD=0.01   # US$ 10 / 1.000 ações + conteúdo cobrado como entrada do modelo
# PROSPECCAO_BUSCA_MAX_ACOES=3               # max_tool_calls por chamada (o limite da pesquisa no Admin prevalece)
# PROSPECCAO_BUSCA_TOKENS_POR_ACAO=60000      # reserva conservadora de conteúdo por ação de pesquisa

# Teto ACUMULADO de todas as chamadas pagas DESTA aplicação (pesquisas, planos e verificações), em US$.
# Não enxerga gastos de outros projetos na mesma conta: use também o limite de orçamento do projeto no painel da OpenAI.
PROSPECCAO_TETO_GLOBAL_USD=1.00

# Opcional – Brave Search API (contratação própria; a chave da OpenAI NÃO habilita a Brave)
# Chave: https://api-dashboard.search.brave.com/register  (US$ 5 / 1.000 consultas)
BRAVE_SEARCH_API_KEY=
# BRAVE_PRECO_POR_CONSULTA_USD=0.005

# Opcional – Anthropic (só se tiver chave própria; não é exigida)
# PROSPECCAO_IA_PROVEDOR=anthropic
# ANTHROPIC_API_KEY=

# Conferir sem exibir valores: python manage.py verificar_integracoes
# Chamada real mínima (com teto):  python manage.py verificar_integracoes --chamar --teto-usd 0.05 [--com-busca]
# Piloto (simulação / execução):   python manage.py piloto_ia --pesquisa 3  [--executar --teto-usd 1.00]

# Base pública de CNPJ (Receita). Pasta local dos zips (fora do OneDrive):
# RECEITA_DIR=C:\Users\<voce>\AppData\Local\BridaProspeccao\receita
