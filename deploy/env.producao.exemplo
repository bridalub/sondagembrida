# Modelo do /opt/apps/sondagem-brida/.env (dono deploy, permissão 600). Nunca vai para o git.
# Os valores marcados GERADO são criados na VPS sem exibição; os marcados VOCÊ são preenchidos pelo responsável.

# --- Compose
IMAGE_TAG=GERADO_commit_atual
WEB_PORT=8050

# --- Django
DJANGO_SECRET_KEY=GERADO
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# 0 durante a validação pelo túnel SSH (http). O publicar_dominio.sh muda para 1 com backup deste arquivo.
DJANGO_HTTPS=0
ANEXO_MAX_MB=15

# --- Banco (container sondagem-brida-db; POSTGRES_HOST/PORT vêm do compose)
POSTGRES_DB=carteira
POSTGRES_USER=carteira
POSTGRES_PASSWORD=GERADO

# --- Salesforce (somente leitura) — VOCÊ preenche. Em branco = nenhuma sincronização.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_INSTANCE_URL=
SF_FILTRO_DISTRIBUIDOR=%BRIDA%
SF_SITUACOES_CLIENTE=Ativo,Inativo,Bloqueado
COMPRAS_DESDE_PADRAO=2026-04-01

# --- Prospecção — VOCÊ preenche as chaves. Em branco = nenhuma chamada paga.
PROSPECCAO_DISPARAR_WORKER=0
PROSPECCAO_IA_PROVEDOR=openai
OPENAI_API_KEY=
PROSPECCAO_IA_MODELO=gpt-6-luna
PROSPECCAO_IA_ESFORCO=low
PROSPECCAO_BUSCA_PROVEDOR=google
SERPAPI_API_KEY=
SERPAPI_PRECO_POR_BUSCA_USD=0
SERPAPI_MAX_REQUISICOES_DIA=20
PROSPECCAO_TETO_GLOBAL_USD=1.00
